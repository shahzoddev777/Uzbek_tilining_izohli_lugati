<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_background">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back button -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_back_button">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Orqaga"
                android:padding="11dp"
                android:rotation="180"
                android:src="@drawable/right"
                app:tint="@color/primary_blue" />

        </FrameLayout>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="@string/rate_app_title"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- MAIN CONTENT -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">


            <!-- ILLUSTRATION CARD -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_rating_illustration">

                    <!-- Decorative circles -->

                    <View
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="-30dp"
                        android:layout_marginTop="-30dp"
                        android:background="@drawable/bg_decor_circle" />

                    <View
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="-25dp"
                        android:layout_marginBottom="-20dp"
                        android:background="@drawable/bg_decor_circle_light" />

                    <ImageView
                        android:id="@+id/img_star_illustration"
                        android:layout_width="190dp"
                        android:layout_height="170dp"
                        android:layout_gravity="center"
                        android:contentDescription="Ilovani baholash"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_rating" />

                </FrameLayout>

            </androidx.cardview.widget.CardView>


            <!-- HEADING -->

            <TextView
                android:id="@+id/tv_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="@string/rate_app_heading"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />


            <!-- DESCRIPTION -->

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/rate_app_description"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />


            <!-- RATING CARD -->

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bahongizni tanlang"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <RatingBar
                        android:id="@+id/ratingBar"
                        style="?android:attr/ratingBarStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:backgroundTint="#E5E7EB"
                        android:isIndicator="false"
                        android:numStars="5"
                        android:progressTint="#FFC107"
                        android:rating="0"
                        android:secondaryProgressTint="#E5E7EB"
                        android:stepSize="1.0" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- BUTTON -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_rate"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_blue"
                android:elevation="4dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/rate_now"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp" />


            <!-- LATER -->

            <TextView
                android:id="@+id/tv_later"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/inter"
                android:padding="8dp"
                android:text="@string/later"
                android:textColor="@color/primary_blue"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- FOOTER -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="O‘zbek tilining izohli lug‘ati"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="So‘zlarning ma’nosi — bir joyda"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>